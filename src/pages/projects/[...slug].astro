---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveMedia } from '../../utils/media';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

type Props = {
  project: Awaited<ReturnType<typeof getCollection>>[number];
};

const { project } = Astro.props;
const { Content } = await project.render();

const media = resolveMedia(project.data.videoSrc, project.data.imageSrc);
---

<BaseLayout title={`${project.data.title} — hoanhi`} description={project.data.description} image={media.coverImage || undefined}>
  <article class="max-w-4xl mx-auto px-6 py-16 animate-fade-in-up">
    <header class="mb-12">
      <a href="/projects" class="text-sm text-[#6b7280] hover:text-[#1a1a1a] transition-colors inline-flex items-center mb-6">
        <svg class="w-4 h-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to projects
      </a>
      
      <h1 class="text-3xl font-bold text-[#1a1a1a] mb-4">{project.data.title}</h1>
      {project.data.description && <p class="text-lg text-[#6b7280] leading-relaxed">{project.data.description}</p>}
      
      {project.data.link && (
        <a href={project.data.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center mt-6 text-[#1a1a1a] font-medium border-b border-[#1a1a1a] hover:text-[#2563eb] hover:border-[#2563eb] transition-colors">
          Visit Project
          <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )}
    </header>

    {/* Featured Media */}
    <div class="mb-12 rounded-2xl overflow-hidden bg-black aspect-video shadow-md border border-[#e8e4dc]">
      {media.embedUrl ? (
        <iframe
          class="w-full h-full"
          src={media.embedUrl}
          title={project.data.title}
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        />
      ) : media.isDirectVideo ? (
        <video
          class="w-full h-full object-contain"
          src={media.videoSrc}
          poster={media.coverImage || undefined}
          controls
          playsinline
        />
      ) : media.coverImage ? (
        <img
          class="w-full h-full object-cover"
          src={media.coverImage}
          alt={project.data.title}
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-[#f0ece4] to-[#e8e4dc]">
          <span class="text-6xl opacity-30">🎨</span>
        </div>
      )}
    </div>

    <div class="prose prose-lg prose-slate max-w-none prose-img:rounded-xl prose-img:shadow-sm">
      <Content />
    </div>
  </article>
</BaseLayout>
