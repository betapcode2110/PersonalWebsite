---
import timelineData from '../data/timeline.json';
---

<section class="max-w-4xl mx-auto px-6 py-16 mt-12 border-t-2 border-black">


  <div class="space-y-0">
    {timelineData.items.map((item, i) => (
      <div class:list={['flex gap-4 items-start py-4 border-l-2 border-black pl-6 relative', 'animate-fade-in-up', `delay-${i + 3}`]}>
        {/* Timeline dot */}
        <div class="absolute -left-[9px] top-5 w-4 h-4 rounded-full bg-white border-2 border-black flex items-center justify-center">
          <div class="w-1.5 h-1.5 rounded-full bg-black"></div>
        </div>
        
        <span class="text-xl shrink-0">{item.emoji}</span>
        <div class="flex-1 min-w-0">
          <p class="text-[#1a1a1a] font-medium text-sm">{item.title}</p>
          {item.subtitle && (
            <p class="text-[#9ca3af] text-sm mt-0.5">{item.subtitle}</p>
          )}
        </div>
        <span class="text-[#9ca3af] text-sm shrink-0 tabular-nums">{item.year}</span>
      </div>
    ))}
  </div>


</section>
