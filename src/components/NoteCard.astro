---
interface Props {
  title: string;
  description: string;
  slug: string;
  tag?: string;
  icon?: string;
  pubDate?: Date;
  heroImage?: string;
  delay?: number;
}

const { title, description, slug, icon = '📝', pubDate, heroImage, delay = 0 } = Astro.props;

// Format date like "September 2023"
const formattedDate = pubDate
  ? pubDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
  : '';
---

<a
  href={`/notes/${slug}/`}
  class:list={[
    'block card card-hover overflow-hidden border-2 border-black rounded-none animate-fade-in-up bg-white min-h-[120px] sm:min-h-[130px]',
    `delay-${delay}`,
  ]}
>
  <div class="flex flex-row items-stretch justify-between h-full">
    <!-- Content side (left) -->
    <div class="flex-1 p-4 sm:p-5 flex flex-col justify-between min-w-0">
      <div>
        <h2 class="font-sans text-[15px] font-semibold text-[#1a1a1a] leading-snug break-words [overflow-wrap:anywhere]">
          <span class="mr-1">{icon}</span>
          {title}
        </h2>
        <p class="text-sm text-[#4b5563] mt-2 leading-relaxed line-clamp-2 break-words [overflow-wrap:anywhere]">
          {description}
        </p>
      </div>
      {formattedDate && (
        <p class="font-sans text-xs font-semibold text-[#1a1a1a] mt-4">
          {formattedDate}
        </p>
      )}
    </div>

    <!-- Image side (right) -->
    {heroImage ? (
      <div class="w-24 min-[400px]:w-32 sm:w-52 md:w-[280px] shrink-0 overflow-hidden">
        <img
          src={heroImage}
          alt={title}
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
    ) : (
      <div class="w-24 min-[400px]:w-32 sm:w-52 md:w-[280px] shrink-0 bg-[#e8e4dc] flex items-center justify-center">
        <span class="text-2xl sm:text-4xl opacity-40">{icon}</span>
      </div>
    )}
  </div>
</a>
