---
const pathname = Astro.url.pathname;
---

<header class="pt-6 pb-2">
  <nav class="max-w-4xl mx-auto px-6 flex items-center justify-center gap-2">
    <a
      href="/"
      class:list={[
        'text-base font-semibold px-5 py-2 rounded-xl transition-all duration-200 inline-block',
        pathname === '/' || pathname.startsWith('/notes')
          ? 'bg-[#dce8f8] text-[#2563eb] -rotate-2'
          : 'text-[#1a1a1a] hover:text-[#6b21a8] hover:bg-[#f3e8ff] hover:-rotate-2',
      ]}
    >
      / notes
    </a>
    <a
      href="/projects"
      class:list={[
        'text-base font-semibold px-5 py-2 rounded-xl transition-all duration-200 inline-block',
        pathname === '/projects'
          ? 'bg-[#dce8f8] text-[#2563eb] -rotate-2'
          : 'text-[#1a1a1a] hover:text-[#6b21a8] hover:bg-[#f3e8ff] hover:-rotate-2',
      ]}
    >
      / projects
    </a>
  </nav>
</header>
