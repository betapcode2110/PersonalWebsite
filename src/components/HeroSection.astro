---
/**
 * Hero Section — matching ameye.dev layout:
 * - Left: profile photo (square, rounded)
 * - Right: card with intro text + email
 * - Below: full-width card with description
 */
---

<section class="max-w-3xl mx-auto px-6 pt-10 pb-6 rounded-md">
  <!-- Top row: Photo + Intro Card -->
  <div class="flex flex-col sm:flex-row gap-4 sm:gap-5 items-start sm:items-stretch animate-fade-in-up">
    <!-- Profile Photo -->
    <div class="shrink-0">
      <div class="w-32 h-32 sm:w-36 sm:h-36 rounded-md bg-[#e8e4dc] overflow-hidden border-2 border-black">
        <!-- Placeholder avatar — replace with your photo -->
        <div class="w-full h-full flex items-center justify-center text-5xl bg-gradient-to-br from-[#e8e4dc] to-[#d1cdc4]">
          🎨
        </div>
      </div>
    </div>

    <!-- Intro Card -->
    <div class="w-full flex-1 card border-2 border-black rounded-md px-5 py-4 sm:px-6 sm:py-5 flex flex-col justify-center bg-white">
      <p class="text-[15px] leading-relaxed">
        <span class="text-lg mr-0.5">👋</span>
        Hello! I am <span class="font-semibold">hoanhi</span>, a
        Technical Artist / 3D Technical Lead.
      </p>
      <p class="mt-3">
        <a
          href="mailto:tranhoan2971999@gmail.com"
          class="text-sm text-[#1a1a1a] border-b border-dotted border-black hover:border-black transition-colors break-all sm:break-normal"
        >
          tranhoan2971999@gmail.com
        </a>
      </p>
    </div>
  </div>

  <!-- Description Card -->
  <div class="card border-2 border-black rounded-md px-6 py-4 mt-4 animate-fade-in-up delay-1 bg-white">
    <p class="text-[15px] text-[#1a1a1a]">
      Here I write about tech art, mobile game development, and other topics that interest me.
    </p>
  </div>
</section>
