---
/**
 * Hero Section — matching ameye.dev layout:
 * - Left: profile photo (square, rounded)
 * - Right: card with intro text + email
 * - Below: full-width card with description
 */
import profile from '../data/profile.json';
import { marked } from 'marked';
---

<section class="max-w-4xl mx-auto px-6 pt-10 pb-6 rounded-md">
  <!-- Top row: Photo + Intro Card -->
  <div class="flex flex-col sm:flex-row gap-4 sm:gap-5 items-start sm:items-stretch animate-fade-in-up">
    <!-- Profile Photo -->
    <div class="shrink-0">
      <div class="w-32 h-32 sm:w-36 sm:h-36 rounded-md bg-[#e8e4dc] overflow-hidden border-2 border-black">
        {profile.avatarImage ? (
          <img src={profile.avatarImage} alt="Avatar" class="w-full h-full object-cover" />
        ) : (
          <div class="w-full h-full flex items-center justify-center text-5xl bg-gradient-to-br from-[#e8e4dc] to-[#d1cdc4]">
            🎨
          </div>
        )}
      </div>
    </div>

    <!-- Intro Card -->
    <div class="w-full flex-1 card border-2 border-black rounded-md px-5 py-4 sm:px-6 sm:py-5 flex flex-col justify-center bg-white prose prose-sm sm:prose-base max-w-none prose-p:first:mt-0 prose-p:last:mb-0 prose-a:text-[#1a1a1a] prose-a:border-b prose-a:border-dotted prose-a:border-black hover:prose-a:border-black prose-a:no-underline">
      <div set:html={marked.parse(profile.intro)} />
    </div>
  </div>

  <!-- Description Card -->
  <div class="card border-2 border-black rounded-md px-6 py-4 mt-4 animate-fade-in-up delay-1 bg-white prose prose-sm sm:prose-base max-w-none prose-p:first:mt-0 prose-p:last:mb-0 text-[#1a1a1a]">
    <div set:html={marked.parse(profile.bio)} />
  </div>
</section>
