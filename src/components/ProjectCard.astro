---
import { resolveMedia } from '../utils/media';

interface Props {
  title: string;
  description?: string;
  link?: string;
  videoSrc?: string;
  imageSrc?: string;
  delay?: number;
}

const { title, description, link, videoSrc, imageSrc, delay = 0 } = Astro.props;

const media = resolveMedia(videoSrc, imageSrc);

const Tag = link ? 'a' : 'div';
const tagProps = link ? {
  href: link,
  target: link.startsWith('http') ? '_blank' : '_self',
  rel: link.startsWith('http') ? 'noopener noreferrer' : ''
} : {};
---

<Tag class:list={['card card-hover overflow-hidden animate-fade-in-up group block', `delay-${delay}`]} {...tagProps}>
  {/* Media section */}
  {media.isDirectVideo ? (
    <div class="relative aspect-video bg-[#f0ece4] overflow-hidden">
      <video
        class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-300"
        src={media.videoSrc}
        poster={media.coverImage || undefined}
        muted
        loop
        playsinline
        preload="metadata"
        onmouseenter="this.play()"
        onmouseleave="this.pause(); this.currentTime = 0;"
      />
    </div>
  ) : media.coverImage ? (
    <div class="relative aspect-video bg-[#f0ece4] overflow-hidden">
      <img
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
        src={media.coverImage}
        alt={title}
        loading="lazy"
      />
      {media.hasVideo && (
        <div class="absolute bottom-3 right-3 bg-black/75 backdrop-blur-xs text-white text-[11px] font-medium px-2 py-0.5 rounded-full flex items-center gap-1 shadow-xs">
          <span>▶</span>
          <span>Video</span>
        </div>
      )}
    </div>
  ) : media.embedUrl ? (
    <div class="relative aspect-video bg-[#f0ece4] overflow-hidden pointer-events-none">
      <iframe
        class="w-full h-full object-cover"
        src={media.embedUrl}
        title={title}
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      />
    </div>
  ) : (
    <div class="aspect-video bg-gradient-to-br from-[#f0ece4] to-[#e8e4dc] flex items-center justify-center">
      <span class="text-5xl opacity-30">🎨</span>
    </div>
  )}

  {/* Info section */}
  <div class="p-5">
    <h3 class="text-lg font-semibold text-[#1a1a1a] group-hover:text-[#2563eb] transition-colors">
      {title}
      {link && (
        <svg class="w-3.5 h-3.5 inline-block ml-1 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      )}
    </h3>
    {description && (
      <p class="text-sm text-[#6b7280] mt-2 leading-relaxed">{description}</p>
    )}
  </div>
</Tag>
