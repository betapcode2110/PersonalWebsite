---
interface Props {
  title: string;
  description?: string;
  link?: string;
  videoSrc?: string;
  imageSrc?: string;
  delay?: number;
}

const { title, description, link, videoSrc, imageSrc, delay = 0 } = Astro.props;
---

<div class:list={['card card-hover overflow-hidden animate-fade-in-up', `delay-${delay}`]}>
  {/* Media section */}
  {videoSrc ? (
    <div class="relative aspect-video bg-[#f0ece4] overflow-hidden">
      <video
        class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-300"
        src={videoSrc}
        muted
        loop
        playsinline
        preload="metadata"
        onmouseenter="this.play()"
        onmouseleave="this.pause(); this.currentTime = 0;"
      />
    </div>
  ) : imageSrc ? (
    <div class="relative aspect-video bg-[#f0ece4] overflow-hidden">
      <img
        class="w-full h-full object-cover"
        src={imageSrc}
        alt={title}
        loading="lazy"
      />
    </div>
  ) : (
    <div class="aspect-video bg-gradient-to-br from-[#f0ece4] to-[#e8e4dc] flex items-center justify-center">
      <span class="text-5xl opacity-30">🎨</span>
    </div>
  )}

  {/* Info section */}
  <div class="p-5">
    {link ? (
      <a href={link} target="_blank" rel="noopener noreferrer" class="text-lg font-semibold text-[#1a1a1a] hover:text-[#2563eb] transition-colors">
        {title}
        <svg class="w-3.5 h-3.5 inline-block ml-1 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    ) : (
      <h3 class="text-lg font-semibold text-[#1a1a1a]">{title}</h3>
    )}
    {description && (
      <p class="text-sm text-[#6b7280] mt-2 leading-relaxed">{description}</p>
    )}
  </div>
</div>
